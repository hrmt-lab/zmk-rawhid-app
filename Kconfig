config RAWHID_APP
    bool "RawHID application protocol layer"
    depends on RAW_HID
    help
      Parse host RawHID packets (HELLO / APP_LAYER / TIME_SYNC / AI_USAGE)
      delivered by zmk-raw-hid via raw_hid_received_event, reply to HELLO,
      and expose decoded state to other modules through getters.

      This is a generic, keyboard-agnostic layer: a keyboard config only needs
      to add this module and enable the options below; no per-keyboard C code.

config RAWHID_APP_LAYER_CONTROL
    bool "Enable RawHID APP_LAYER host layer control"
    depends on RAW_HID
    select RAWHID_APP
    help
      Handle APP_LAYER (0x30) packets that let a host activate / clear one ZMK
      layer.

config RAWHID_APP_TIME_SYNC
    bool "Enable RawHID TIME_SYNC"
    depends on RAW_HID
    select RAWHID_APP
    help
      Handle TIME_SYNC (0x20) packets and expose formatted local time through
      rawhid_app_time_sync_format() / rawhid_app_time_sync_wants_seconds().

config RAWHID_APP_AI_USAGE
    bool "Enable RawHID AI_USAGE"
    depends on RAW_HID
    select RAWHID_APP
    help
      Handle AI_USAGE (0x10) packets (Codex / Claude Code 5h and 7d usage) and
      expose the latest per-provider state through rawhid_app_ai_usage_get().

config RAWHID_APP_AI_CLIENT_STATE
    bool "Enable RawHID AI client state core"
    depends on RAW_HID
    select RAWHID_APP
    help
      Validate and retain AI_CLIENT / STATE_UPDATE packets using arrival-order
      last-write-wins semantics. The current state expires after 15 seconds
      without a valid update.

config RAWHID_APP_AI_CLIENT_STATE_RENDERER
    bool "Declare an AI client state renderer"
    depends on RAWHID_APP_AI_CLIENT_STATE
    help
      Enable this only when the target includes at least one display, LED,
      vibration, sound, or another renderer that consumes AI client state.
      CAP_AI_CLIENT_STATE and CAP_AI_CLIENT_WORK_PHASE are advertised only
      when both this option and the AI client state core are enabled.

config RAWHID_APP_AI_CLIENT_CLAUDE_CODE_RENDERER
    bool "Declare a Claude Code capable AI client state renderer"
    depends on RAWHID_APP_AI_CLIENT_STATE_RENDERER
    help
      Enable this only when the target's renderer can represent Claude Code as
      a distinct AI client, for example with its own logo on a display or with
      a defined LED / vibration / sound expression. The AI client state core
      always accepts client_type CLAUDE_CODE; this option only controls the
      CAP_AI_CLIENT_CLAUDE_CODE (bit 12) advertisement, which is never sent
      without CAP_AI_CLIENT_STATE.

config RAWHID_APP_AI_CLIENT_DISPLAY_SLOT_RENDERER
    bool "Declare a multi screen AI client state renderer"
    depends on RAWHID_APP_AI_CLIENT_STATE_RENDERER
    help
      Enable this only when the target drives one physical renderer per logical
      display slot, so that the host can address each screen separately. The AI
      client state core always accepts the 8 byte payload; this option only
      controls the CAP_AI_CLIENT_DISPLAY_SLOT (bit 13) advertisement, which is
      never sent without CAP_AI_CLIENT_STATE and CAP_AI_CLIENT_WORK_PHASE.
      Hosts send only slot 0, in the 6 or 7 byte form, to devices without it.

config RAWHID_APP_AI_CLIENT_SCREENKEY_STATE_RENDERER
    bool "Declare ScreenKey AI client display-state support"
    depends on RAWHID_APP_AI_CLIENT_DISPLAY_SLOT_RENDERER
    help
      Enable this only when the target renders the ninth AI_CLIENT_STATE byte
      as ScreenKey state. This controls the CAP_AI_CLIENT_SCREENKEY_STATE
      (bit 14) advertisement; it is never sent without the AI client state,
      work phase, and display slot capabilities. Hosts keep sending the legacy
      8 byte form to targets without this declaration.

config RAWHID_APP_AI_CLIENT_DISPLAY_SLOT_COUNT
    int "Number of logical AI client display slots to retain"
    depends on RAWHID_APP_AI_CLIENT_STATE
    range 1 8
    default 1
    help
      How many logical display slots the core keeps independent state, revision
      and host timeout for. Set this to the number of physical AI client
      renderers on the target. Updates addressed to a higher slot are dropped
      without affecting any retained slot. The default of 1 matches the legacy
      single screen behaviour and costs no extra RAM.

config RAWHID_APP_BATTERY_REPORT
    bool "Enable RawHID BATTERY_STATUS uplink"
    depends on RAW_HID
    select RAWHID_APP
    help
      Send central/self and split peripheral battery levels to the host.
      Source 0 is the central/self RawHID endpoint; sources 1..3 are
      peripheral slots. Level 0xff means unknown, not available, or
      disconnected.

config RAWHID_APP_SPLIT_CENTRAL_STATUS_EVENT
    bool
    depends on RAWHID_APP_BATTERY_REPORT
    depends on ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL
    default y if SHIELD_PROSPECTOR_ADAPTER
    default y if SHIELD_SUMIRE_DONGLE

config RAWHID_APP_HOST_ACTION
    bool "Enable RawHID HOST_ACTION behavior uplink"
    depends on RAW_HID
    select RAWHID_APP
    help
      Enable the &host_action behavior to send action ID/value pairs to the host.

config RAWHID_APP_KEY_STATS
    bool "Enable RawHID KEY_STATS uplink"
    depends on RAW_HID
    select RAWHID_APP
    help
      Count key presses in a uint16_t array sized by ZMK_KEYMAP_LEN and
      periodically send deltas to the host. This is opt-in because it consumes
      RAM proportional to the physical key count.

config RAWHID_APP_KEY_PRESS
    bool "Enable RawHID KEY_PRESS uplink"
    depends on RAW_HID
    select RAWHID_APP
    help
      Send each key press and release event to the host immediately.

config RAWHID_APP_LAYER_STATE_REPORT
    bool "Enable RawHID LAYER_STATE uplink"
    depends on RAW_HID
    select RAWHID_APP
    help
      Send the current highest active layer and layer-state mask to the host
      after layer changes and after HOST_HELLO.

config RAWHID_APP_CONFIG_RPC
    bool "Enable RawHID CONFIG_RPC requests"
    depends on RAW_HID
    select RAWHID_APP
    select SETTINGS
    select TINYCRYPT
    select TINYCRYPT_SHA256
    help
      Handle Host Link CONFIG_REQUEST / CONFIG_RESPONSE packets. The encoder
      implementation supports GET_INFO, GET_BINDINGS, SET_BINDINGS, GET_DIRTY,
      SAVE, DISCARD, and CLEAR_OVERRIDE. SAVE requires a working settings
      backend in the keyboard configuration. When RAWHID_APP_COMBO_RUNTIME is
      enabled, the Combo feature additionally provides read-only GET_INFO and
      GET_COMBO operations.

config RAWHID_APP_COMBO_RUNTIME
    bool "Enable Keylink runtime Combo engine"
    help
      Replace the ZMK devicetree Combo listener with the Keylink runtime Combo
      engine. The /combos node must exist and have status = "disabled" so ZMK's
      built-in listener is absent while its child definitions remain available
      as Keylink's read-only defaults.

config RAWHID_APP_COMBO_SETTINGS_CORE
    bool
    depends on RAWHID_APP_COMBO_RUNTIME

config RAWHID_APP_COMBO_SETTINGS
    bool "Enable Keylink Combo Settings table"
    depends on RAWHID_APP_COMBO_RUNTIME && RAWHID_APP_CONFIG_RPC && NVS
    select RAWHID_APP_COMBO_SETTINGS_CORE
    select TINYCRYPT
    select TINYCRYPT_SHA256
    help
      Load the fixed 2,064 byte Keylink Combo table from
      keylink/cmb/v1/table. This option is deliberately limited to the
      Zephyr NVS Settings backend: record version 1 depends on a single NVS
      value being atomically replaced. Runtime Combo remains usable without
      this option, in which case CONFIG RPC reports STORAGE_UNAVAILABLE.

config RAWHID_APP_COMBO_SETTINGS_TEST
    bool
    default n
    depends on RAWHID_APP_COMBO_RUNTIME && BOARD_NATIVE_SIM
    select RAWHID_APP_COMBO_SETTINGS_CORE
    help
      Internal native-fixture switch. It deliberately has no prompt and must
      only be enabled by the Combo Settings test configuration.
